# Obsygnal-Pulse .gitignore - Prevents local development artifacts, compiled Go binaries,
# cached Node modules, and sensitive environment variable files from being committed into the monorepo.

# Binaries
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test
coverage.out
coverage.html
*.test

# Environment
.env

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker volumes (if local)
data/

# Node modules (frontend)
web/node_modules/
web/dist/
web/.next/

# Terraform
deploy/terraform/**/.terraform/
deploy/terraform/**/*.tfstate
deploy/terraform/**/*.tfstate.backup
deploy/terraform/**/.terraform.lock.hcl

# Temporary
tmp/
.gotmp/
*.tmp
*.log
