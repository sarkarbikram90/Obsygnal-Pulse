# ============================================================
# Obsygnal-Pulse Environment Configuration Map
# This template defines all 12-factor configuration variables for the
# API Server, Worker, Collector, and Simulator.
# ============================================================

# Server
ENVIRONMENT=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=120s
CORS_ALLOWED_ORIGINS=*

# ClickHouse OLAP Data Lake
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=obsygnal
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=obsygnal_dev
CLICKHOUSE_MAX_OPEN_CONNS=10
CLICKHOUSE_MAX_IDLE_CONNS=5
CLICKHOUSE_CONN_MAX_LIFETIME=10m
CLICKHOUSE_BATCH_SIZE=10000
CLICKHOUSE_FLUSH_INTERVAL=5s

# Redis (Rate Limiting & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# NATS JetStream (Event Bus)
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=telemetry
NATS_MAX_RETRIES=3
NATS_ACK_WAIT=30s

# Prometheus DCGM Exporter Scraper
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_QUERY_TIMEOUT=30s
PROMETHEUS_SCRAPE_INTERVAL=15s

# Authentication & SaaS Control Plane (Set a secure secret in staging/production)
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
BCRYPT_COST=12

# Edge Collector Daemon
COLLECTOR_SCRAPE_INTERVAL=15s
COLLECTOR_BATCH_SIZE=1000
COLLECTOR_MAX_CONCURRENT_SCRAPES=5
COLLECTOR_STALENESS_THRESHOLD=5m

# Inefficiency Detection Engine
DETECTION_EVALUATION_INTERVAL=60s
DETECTION_GPU_UTIL_THRESHOLD=20.0
DETECTION_MEM_UTIL_THRESHOLD=15.0
DETECTION_IDLE_TIME_THRESHOLD=30m
DETECTION_RETRY_THRESHOLD=3

# Alerting & Incident Channels
ALERTING_SLACK_WEBHOOK_URL=
ALERTING_WEBHOOK_URLS=
ALERTING_DEDUP_WINDOW=15m
ALERTING_RATE_LIMIT_PER_MIN=10

# OpenTelemetry Distributed Tracing & Metrics
OTEL_SERVICE_NAME=obsygnal-pulse
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SAMPLING_RATE=0.1
OTEL_METRICS_ENABLED=true
OTEL_TRACES_ENABLED=true
